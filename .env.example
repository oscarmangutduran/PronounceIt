# ==============================================================================
# PRONOUNCEIT - FULLSTACK ENVIRONMENT ARCHITECTURE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT BUNDLE (PÚBLICO - React Native / Vite Web)
# ------------------------------------------------------------------------------
# Solo configuraciones públicas del cliente. Ninguna clave sensible debe ir aquí.
EXPO_PUBLIC_API_URL="http://localhost:5000/api"
VITE_API_URL="http://localhost:5000/api"

VITE_FIREBASE_API_KEY="AIzaSyYourClientApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

EXPO_PUBLIC_FIREBASE_API_KEY="AIzaSyYourClientApiKeyHere"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
EXPO_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 2. BACKEND EXPRESS (PRIVADO - Servidor / Docker)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=generate_a_secure_random_64_character_string_here
JWT_EXPIRES_IN=7d

# Credenciales SMTP del servidor
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_secure_smtp_password
EMAIL_FROM_NAME="PronounceIt"

# ------------------------------------------------------------------------------
# 3. FIREBASE CLOUD FUNCTIONS & GOOGLE CLOUD (SECRETS MANAGER)
# ------------------------------------------------------------------------------
# Los secretos sensibles NO se almacenan en texto plano en archivos .env en producción.
# Se configuran en Google Cloud Secret Manager mediante Firebase CLI:
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Para emulación local exclusivamente (functions/.secret.local):
# GEMINI_API_KEY="your-gemini-api-key"
