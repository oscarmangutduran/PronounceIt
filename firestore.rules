rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para colecciones de cuentas de PronounceIt
    match /accounts/{docId} {
      allow read, write: if true;
    }

    // Reglas para usuarios y sus datos privados (subcolecciones words, test_history, etc.)
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Colección global de vocabulario
    match /words/{wordId} {
      allow read, write: if true;
    }

    // Colección global de historial de exámenes
    match /test_history/{testId} {
      allow read, write: if true;
    }

  }
}

