rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // PRINCIPIO DE MENOR PRIVILEGIO: BLOQUEO POR DEFECTO
    // Cualquier ruta no declarada explícitamente queda denegada.
    // ============================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================================
    // FUNCIONES AUXILIARES DE SEGURIDAD
    // ============================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================================================
    // COLECCIÓN DE USUARIOS: AISLAMIENTO ESTRICTO POR UID
    // ============================================================================
    match /users/{userId} {
      // Solo el propietario puede consultar, actualizar o borrar su perfil
      allow read, update, delete: if isOwner(userId);
      
      // Permitir la creación de su propio perfil con el UID correspondiente
      allow create: if isOwner(userId) && request.resource.data.id == userId;

      // Subcolecciones privadas del usuario (palabras personales, categorías, historial de tests)
      match /words/{wordId} {
        allow read, write: if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      match /test_history/{testId} {
        allow read, write: if isOwner(userId);
      }

      // Regla recursiva para cualquier otra subcolección anidada del usuario
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================================================
    // CATÁLOGO GLOBAL DE VOCABULARIO (SOLO LECTURA PARA AUTENTICADOS)
    // ============================================================================
    match /words/{wordId} {
      // Los usuarios autenticados pueden consultar el diccionario común
      allow read: if isAuthenticated();
      // Ningún cliente puede modificar o borrar el catálogo global directamente
      // Solo Cloud Functions o Admin SDK tienen permisos de escritura
      allow write: if false;
    }

    // ============================================================================
    // HISTORIAL GLOBAL DE EXÁMENES
    // ============================================================================
    match /test_history/{testId} {
      // Lectura permitida si el registro pertenece al usuario autenticado
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      // Creación permitida solo si el UID enviado coincide con el del token
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Actualización y borrado solo por su propio autor
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============================================================================
    // COLECCIÓN DE CUENTAS INTERNAS (PROTECCIÓN TOTAL)
    // ============================================================================
    // Previene la lectura o modificación pública de cuentas y contraseñas
    match /accounts/{docId} {
      allow read, write: if false;
    }

  }
}
