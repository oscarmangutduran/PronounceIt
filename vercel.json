{
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "redirects": [
    {
      "source": "/PronounceIt.apk",
      "destination": "https://github.com/oscarmangutduran/PronounceIt/releases/download/v1.6.9/PronounceIt-v1.6.9.apk",
      "permanent": false
    },
    {
      "source": "/PronounceIt-v1.6.9.apk",
      "destination": "https://github.com/oscarmangutduran/PronounceIt/releases/download/v1.6.9/PronounceIt-v1.6.9.apk",
      "permanent": false
    },
    {
      "source": "/PronounceIt-v1.6.8.apk",
      "destination": "https://github.com/oscarmangutduran/PronounceIt/releases/download/v1.6.8/PronounceIt-v1.6.8.apk",
      "permanent": false
    },
    {
      "source": "/download-apk",
      "destination": "https://github.com/oscarmangutduran/PronounceIt/releases/download/v1.6.9/PronounceIt-v1.6.9.apk",
      "permanent": false
    },
    {
      "source": "/apk",
      "destination": "https://github.com/oscarmangutduran/PronounceIt/releases/download/v1.6.9/PronounceIt-v1.6.9.apk",
      "permanent": false
    },
    {
      "source": "/apple",
      "destination": "/?install=apple",
      "permanent": false
    },
    {
      "source": "/ios",
      "destination": "/?install=apple",
      "permanent": false
    },
    {
      "source": "/download-apple",
      "destination": "/?install=apple",
      "permanent": false
    },
    {
      "source": "/download-ios",
      "destination": "/?install=apple",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
