ring',pastSimple:'brought',pastParticiple:'brought',translation:'Traer',level:'A2',phonetics:{infinitive:'/br\u026a\u014b/',pastSimple:'/br\u0254\u02d0t/',pastParticiple:'/br\u0254\u02d0t/'},exampleEn:'They brought good news to the team.',exampleEs:'Ellos trajeron buenas noticias al equipo.'},{id:'iv-begin',infinitive:'begin',pastSimple:'began',pastParticiple:'begun',translation:'Empezar / Comenzar',level:'A2',phonetics:{infinitive:'/b\u026a\u02c8\u0261\u026an/',pastSimple:'/b\u026a\u02c8\u0261\xe6n/',pastParticiple:'/b\u026a\u02c8\u0261\u028cn/'},exampleEn:'The conference began at 9:00 AM.',exampleEs:'La conferencia comenz\xf3 a las 9:00 AM.'},{id:'iv-keep',infinitive:'keep',pastSimple:'kept',pastParticiple:'kept',translation:'Mantener / Guardar',level:'A2',phonetics:{infinitive:'/ki\u02d0p/',pastSimple:'/k\u025bpt/',pastParticiple:'/k\u025bpt/'},exampleEn:'She kept her promise to help.',exampleEs:'Ella mantuvo su promesa de ayudar.'},{id:'iv-write',infinitive:'write',pastSimple:'wrote',pastParticiple:'written',translation:'Escribir',level:'A2',phonetics:{infinitive:'/ra\u026at/',pastSimple:'/ro\u028at/',pastParticiple:'/\u02c8r\u026at\u0259n/'},exampleEn:'He wrote a concise summary of the project.',exampleEs:'\xc9l escribi\xf3 un resumen conciso del proyecto.'},{id:'iv-hear',infinitive:'hear',pastSimple:'heard',pastParticiple:'heard',translation:'O\xedr / Escuchar',level:'A2',phonetics:{infinitive:'/h\u026a\u0259r/',pastSimple:'/h\u025c\u02d0rd/',pastParticiple:'/h\u025c\u02d0rd/'},exampleEn:'We heard the announcement over the speaker.',exampleEs:'O\xedmos el anuncio por los altavoces.'},{id:'iv-let',infinitive:'let',pastSimple:'let',pastParticiple:'let',translation:'Permitir / Dejar',level:'A2',phonetics:{infinitive:'/l\u025bt/',pastSimple:'/l\u025bt/',pastParticiple:'/l\u025bt/'},exampleEn:'They let us enter without delay.',exampleEs:'Nos dejaron entrar sin demora.'},{id:'iv-meet',infinitive:'meet',pastSimple:'met',pastParticiple:'met',translation:'Conocer / Reunirse',level:'A2',phonetics:{infinitive:'/mi\u02d0t/',pastSimple:'/m\u025bt/',pastParticiple:'/m\u025bt/'},exampleEn:'I met the new clients this morning.',exampleEs:'Me reun\xed con los nuevos clientes esta ma\xf1ana.'},{id:'iv-run',infinitive:'run',pastSimple:'ran',pastParticiple:'run',translation:'Correr / Dirigir',level:'A2',phonetics:{infinitive:'/r\u028cn/',pastSimple:'/r\xe6n/',pastParticiple:'/r\u028cn/'},exampleEn:'She ran five kilometers before breakfast.',exampleEs:'Ella corri\xf3 cinco kil\xf3metros antes del desayuno.'},{id:'iv-pay',infinitive:'pay',pastSimple:'paid',pastParticiple:'paid',translation:'Pagar',level:'A2',phonetics:{infinitive:'/pe\u026a/',pastSimple:'/pe\u026ad/',pastParticiple:'/pe\u026ad/'},exampleEn:'We paid the invoice immediately.',exampleEs:'Pagamos la factura de inmediato.'},{id:'iv-sit',infinitive:'sit',pastSimple:'sat',pastParticiple:'sat',translation:'Sentarse',level:'A2',phonetics:{infinitive:'/s\u026at/',pastSimple:'/s\xe6t/',pastParticiple:'/s\xe6t/'},exampleEn:'He sat in the front row.',exampleEs:'\xc9l se sent\xf3 en la primera fila.'},{id:'iv-speak',infinitive:'speak',pastSimple:'spoke',pastParticiple:'spoken',translation:'Hablar',level:'A2',phonetics:{infinitive:'/spi\u02d0k/',pastSimple:'/spo\u028ak/',pastParticiple:'/\u02c8spo\u028ak\u0259n/'},exampleEn:'She spoke clearly during the presentation.',exampleEs:'Ella habl\xf3 con claridad durante la presentaci\xf3n.'},{id:'iv-read',infinitive:'read',pastSimple:'read',pastParticiple:'read',translation:'Leer',level:'A2',phonetics:{infinitive:'/ri\u02d0d/',pastSimple:'/r\u025bd/',pastParticiple:'/r\u025bd/'},exampleEn:'He read the contract carefully.',exampleEs:'\xc9l ley\xf3 el contrato con atenci\xf3n.'},{id:'iv-lose',infinitive:'lose',pastSimple:'lost',pastParticiple:'lost',translation:'Perder',level:'A2',phonetics:{infinitive:'/lu\u02d0z/',pastSimple:'/l\u0252st/',pastParticiple:'/l\u0252st/'},exampleEn:'They lost connection for a few minutes.',exampleEs:'Perdieron la conexi\xf3n durante unos minutos.'},{id:'iv-send',infinitive:'send',pastSimple:'sent',pastParticiple:'sent',translation:'Enviar',level:'A2',phonetics:{infinitive:'/s\u025bnd/',pastSimple:'/s\u025bnt/',pastParticiple:'/s\u025bnt/'},exampleEn:'I sent the report by email.',exampleEs:'Envi\xe9 el informe por correo electr\xf3nico.'},{id:'iv-buy',infinitive:'buy',pastSimple:'bought',pastParticiple:'bought',translation:'Comprar',level:'A2',phonetics:{infinitive:'/ba\u026a/',pastSimple:'/b\u0254\u02d0t/',pastParticiple:'/b\u0254\u02d0t/'},exampleEn:'She bought a new laptop for work.',exampleEs:'Ella compr\xf3 un nuevo port\xe1til para trabajar.'},{id:'iv-drive',infinitive:'drive',pastSimple:'drove',pastParticiple:'driven',translation:'Conducir',level:'A2',phonetics:{infinitive:'/dra\u026av/',pastSimple:'/dro\u028av/',pastParticiple:'/\u02c8dr\u026av\u0259n/'},exampleEn:'He drove safely in the heavy rain.',exampleEs:'\xc9l condujo con seguridad bajo la intensa lluvia.'},{id:'iv-break',infinitive:'break',pastSimple:'broke',pastParticiple:'broken',translation:'Romper',level:'A2',phonetics:{infinitive:'/bre\u026ak/',pastSimple:'/bro\u028ak/',pastParticiple:'/\u02c8bro\u028ak\u0259n/'},exampleEn:'She accidentally broke the vase.',exampleEs:'Ella rompi\xf3 accidentalmente el jarr\xf3n.'},{id:'iv-eat',infinitive:'eat',pastSimple:'ate',pastParticiple:'eaten',translation:'Comer',level:'A2',phonetics:{infinitive:'/i\u02d0t/',pastSimple:'/e\u026at/',pastParticiple:'/\u02c8i\u02d0t\u0259n/'},exampleEn:'We ate lunch together in the garden.',exampleEs:'Comimos juntos en el jard\xedn.'},{id:'iv-arise',infinitive:'arise',pastSimple:'arose',pastParticiple:'arisen',translation:'Surgir / Levantarse',level:'B1',phonetics:{infinitive:'/\u0259\u02c8ra\u026az/',pastSimple:'/\u0259\u02c8ro\u028az/',pastParticiple:'/\u0259\u02c8r\u026az\u0259n/'},exampleEn:'A sudden problem arose during testing.',exampleEs:'Surgi\xf3 un problema repentino durante las pruebas.'},{id:'iv-beat',infinitive:'beat',pastSimple:'beat',pastParticiple:'beaten',translation:'Vencer / Golpear / Batir',level:'B1',phonetics:{infinitive:'/bi\u02d0t/',pastSimple:'/bi\u02d0t/',pastParticiple:'/\u02c8bi\u02d0t\u0259n/'},exampleEn:'Our team beat the champions in the final.',exampleEs:'Nuestro equipo venci\xf3 a los campeones en la final.'},{id:'iv-bend',infinitive:'bend',pastSimple:'bent',pastParticiple:'bent',translation:'Doblar / Inclinar',level:'B1',phonetics:{infinitive:'/b\u025bnd/',pastSimple:'/b\u025bnt/',pastParticiple:'/b\u025bnt/'},exampleEn:'He bent down to pick up his pen.',exampleEs:'\xc9l se inclin\xf3 para recoger su bol\xedgrafo.'},{id:'iv-bite',infinitive:'bite',pastSimple:'bit',pastParticiple:'bitten',translation:'Morder',level:'B1',phonetics:{infinitive:'/ba\u026at/',pastSimple:'/b\u026at/',pastParticiple:'/\u02c8b\u026at\u0259n/'},exampleEn:'The dog bit the wooden stick.',exampleEs:'El perro mordi\xf3 el palo de madera.'},{id:'iv-blow',infinitive:'blow',pastSimple:'blew',pastParticiple:'blown',translation:'Soplar',level:'B1',phonetics:{infinitive:'/blo\u028a/',pastSimple:'/blu\u02d0/',pastParticiple:'/blo\u028an/'},exampleEn:'The wind blew the autumn leaves across the street.',exampleEs:'El viento sopl\xf3 las hojas de oto\xf1o por la calle.'},{id:'iv-deal',infinitive:'deal',pastSimple:'dealt',pastParticiple:'dealt',translation:'Tratar / Negociar / Repartir',level:'B1',phonetics:{infinitive:'/di\u02d0l/',pastSimple:'/d\u025blt/',pastParticiple:'/d\u025blt/'},exampleEn:'She dealt with the customer complaint calmly.',exampleEs:'Ella trat\xf3 la queja del cliente con calma.'},{id:'iv-dig',infinitive:'dig',pastSimple:'dug',pastParticiple:'dug',translation:'Cavar / Excavar',level:'B1',phonetics:{infinitive:'/d\u026a\u0261/',pastSimple:'/d\u028c\u0261/',pastParticiple:'/d\u028c\u0261/'},exampleEn:'They dug a trench for the water pipe.',exampleEs:'Cavaron una zanja para la tuber\xeda de agua.'},{id:'iv-feed',infinitive:'feed',pastSimple:'fed',pastParticiple:'fed',translation:'Alimentar',level:'B1',phonetics:{infinitive:'/fi\u02d0d/',pastSimple:'/f\u025bd/',pastParticiple:'/f\u025bd/'},exampleEn:'She fed the birds in the park every morning.',exampleEs:'Ella alimentaba a las aves en el parque cada ma\xf1ana.'},{id:'iv-fight',infinitive:'fight',pastSimple:'fought',pastParticiple:'fought',translation:'Luchar / Pelear',level:'B1',phonetics:{infinitive:'/fa\u026at/',pastSimple:'/f\u0254\u02d0t/',pastParticiple:'/f\u0254\u02d0t/'},exampleEn:'They fought for equal rights.',exampleEs:'Lucharon por la igualdad de derechos.'},{id:'iv-freeze',infinitive:'freeze',pastSimple:'froze',pastParticiple:'frozen',translation:'Congelar',level:'B1',phonetics:{infinitive:'/fri\u02d0z/',pastSimple:'/fro\u028az/',pastParticiple:'/\u02c8fro\u028az\u0259n/'},exampleEn:'The lake froze during the cold winter night.',exampleEs:'El lago se congel\xf3 durante la fr\xeda noche de invierno.'},{id:'iv-hide',infinitive:'hide',pastSimple:'hid',pastParticiple:'hidden',translation:'Esconder / Ocultar',level:'B1',phonetics:{infinitive:'/ha\u026ad/',pastSimple:'/h\u026ad/',pastParticiple:'/\u02c8h\u026ad\u0259n/'},exampleEn:'He hid the present until her birthday.',exampleEs:'\xc9l escondi\xf3 el regalo hasta su cumplea\xf1os.'},{id:'iv-lend',infinitive:'lend',pastSimple:'lent',pastParticiple:'lent',translation:'Prestar',level:'B1',phonetics:{infinitive:'/l\u025bnd/',pastSimple:'/l\u025bnt/',pastParticiple:'/l\u025bnt/'},exampleEn:'She lent me her dictionary for the exam.',exampleEs:'Ella me prest\xf3 su diccionario para el examen.'},{id:'iv-ride',infinitive:'ride',pastSimple:'rode',pastParticiple:'ridden',translation:'Montar / Cabalgar',level:'B1',phonetics:{infinitive:'/ra\u026ad/',pastSimple:'/ro\u028ad/',pastParticiple:'/\u02c8r\u026ad\u0259n/'},exampleEn:'We rode our bicycles along the river.',exampleEs:'Montamos en bicicleta a lo largo del r\xedo.'},{id:'iv-ring',infinitive:'ring',pastSimple:'rang',pastParticiple:'rung',translation:'Sonar / Llamar por tel\xe9fono',level:'B1',phonetics:{infinitive:'/r\u026a\u014b/',pastSimple:'/r\xe6\u014b/',pastParticiple:'/r\u028c\u014b/'},exampleEn:'The bell rang twice before they answered.',exampleEs:'La campana son\xf3 dos veces antes de que respondieran.'},{id:'iv-rise',infinitive:'rise',pastSimple:'rose',pastParticiple:'risen',translation:'Subir / Elevarse / Levantarse',level:'B1',phonetics:{infinitive:'/ra\u026az/',pastSimple:'/ro\u028az/',pastParticiple:'/\u02c8r\u026az\u0259n/'},exampleEn:'Prices rose by five percent this quarter.',exampleEs:'Los precios subieron un cinco por ciento este trimestre.'},{id:'iv-shake',infinitive:'shake',pastSimple:'shook',pastParticiple:'shaken',translation:'Agitar / Estrechar la mano',level:'B1',phonetics:{infinitive:'/\u0283e\u026ak/',pastSimple:'/\u0283\u028ak/',pastParticiple:'/\u02c8\u0283e\u026ak\u0259n/'},exampleEn:'They shook hands after reaching an agreement.',exampleEs:'Se dieron la mano tras alcanzar un acuerdo.'},{id:'iv-shine',infinitive:'shine',pastSimple:'shone',pastParticiple:'shone',translation:'Brillar',level:'B1',phonetics:{infinitive:'/\u0283a\u026an/',pastSimple:'/\u0283o\u028an/',pastParticiple:'/\u0283o\u028an/'},exampleEn:'The sun shone brightly all afternoon.',exampleEs:'El sol brill\xf3 intensamente toda la tarde.'},{id:'iv-shoot',infinitive:'shoot',pastSimple:'shot',pastParticiple:'shot',translation:'Disparar / Filmar',level:'B1',phonetics:{infinitive:'/\u0283u\u02d0t/',pastSimple:'/\u0283\u0252t/',pastParticiple:'/\u0283\u0252t/'},exampleEn:'The photographer shot great pictures.',exampleEs:'El fot\xf3grafo tom\xf3 excelentes fotos.'},{id:'iv-sink',infinitive:'sink',pastSimple:'sank',pastParticiple:'sunk',translation:'Hundirse',level:'B2',phonetics:{infinitive:'/s\u026a\u014bk/',pastSimple:'/s\xe6\u014bk/',pastParticiple:'/s\u028c\u014bk/'},exampleEn:'The heavy rock sank quickly to the bottom.',exampleEs:'La pesada roca se hundi\xf3 r\xe1pidamente hasta el fondo.'},{id:'iv-slide',infinitive:'slide',pastSimple:'slid',pastParticiple:'slid',translation:'Deslizar',level:'B2',phonetics:{infinitive:'/sla\u026ad/',pastSimple:'/sl\u026ad/',pastParticiple:'/sl\u026ad/'},exampleEn:'The glass slid across the polished table.',exampleEs:'El vaso se desliz\xf3 por la mesa pulida.'},{id:'iv-spread',infinitive:'spread',pastSimple:'spread',pastParticiple:'spread',translation:'Esparcir / Difundir',level:'B2',phonetics:{infinitive:'/spr\u025bd/',pastSimple:'/spr\u025bd/',pastParticiple:'/spr\u025bd/'},exampleEn:'The news spread rapidly across social media.',exampleEs:'La noticia se difundi\xf3 con rapidez en las redes sociales.'},{id:'iv-steal',infinitive:'steal',pastSimple:'stole',pastParticiple:'stolen',translation:'Robar',level:'B2',phonetics:{infinitive:'/sti\u02d0l/',pastSimple:'/sto\u028al/',pastParticiple:'/\u02c8sto\u028al\u0259n/'},exampleEn:'Someone stole his wallet on the subway.',exampleEs:'Alguien le rob\xf3 la cartera en el metro.'},{id:'iv-stick',infinitive:'stick',pastSimple:'stuck',pastParticiple:'stuck',translation:'Pegar / Quedarse atascado',level:'B2',phonetics:{infinitive:'/st\u026ak/',pastSimple:'/st\u028ck/',pastParticiple:'/st\u028ck/'},exampleEn:'The paper stuck firmly to the noticeboard.',exampleEs:'El papel se peg\xf3 firmemente al tabl\xf3n de anuncios.'},{id:'iv-strike',infinitive:'strike',pastSimple:'struck',pastParticiple:'struck',translation:'Golpear / Impactar',level:'B2',phonetics:{infinitive:'/stra\u026ak/',pastSimple:'/str\u028ck/',pastParticiple:'/str\u028ck/'},exampleEn:'Lightning struck the tall tower.',exampleEs:'Un rayo impact\xf3 la torre alta.'},{id:'iv-swear',infinitive:'swear',pastSimple:'swore',pastParticiple:'sworn',translation:'Jurar / Maldecir',level:'B2',phonetics:{infinitive:'/sw\u025b\u0259r/',pastSimple:'/sw\u0254\u02d0r/',pastParticiple:'/sw\u0254\u02d0rn/'},exampleEn:'He swore to tell the truth in court.',exampleEs:'\xc9l jur\xf3 decir la verdad ante el tribunal.'},{id:'iv-sweep',infinitive:'sweep',pastSimple:'swept',pastParticiple:'swept',translation:'Barrer / Arrastrar',level:'B2',phonetics:{infinitive:'/swi\u02d0p/',pastSimple:'/sw\u025bpt/',pastParticiple:'/sw\u025bpt/'},exampleEn:'She swept the floor before guests arrived.',exampleEs:'Ella barri\xf3 el suelo antes de que llegaran los invitados.'},{id:'iv-tear',infinitive:'tear',pastSimple:'tore',pastParticiple:'torn',translation:'Rasgar / Desgarrar',level:'B2',phonetics:{infinitive:'/t\u025b\u0259r/',pastSimple:'/t\u0254\u02d0r/',pastParticiple:'/t\u0254\u02d0rn/'},exampleEn:'He tore open the envelope with excitement.',exampleEs:'\xc9l rasg\xf3 el sobre con entusiasmo.'},{id:'iv-throw',infinitive:'throw',pastSimple:'threw',pastParticiple:'thrown',translation:'Lanzar / Tirar',level:'B2',phonetics:{infinitive:'/\u03b8ro\u028a/',pastSimple:'/\u03b8ru\u02d0/',pastParticiple:'/\u03b8ro\u028an/'},exampleEn:'She threw the ball straight to her teammate.',exampleEs:'Ella lanz\xf3 la pelota directamente a su compa\xf1era.'},{id:'iv-cling',infinitive:'cling',pastSimple:'clung',pastParticiple:'clung',translation:'Aferrarse / Pegarse',level:'C1',phonetics:{infinitive:'/kl\u026a\u014b/',pastSimple:'/kl\u028c\u014b/',pastParticiple:'/kl\u028c\u014b/'},exampleEn:'The wet clothes clung to his skin.',exampleEs:'La ropa mojada se aferraba a su piel.'},{id:'iv-creep',infinitive:'creep',pastSimple:'crept',pastParticiple:'crept',translation:'Arrastrarse / Deslizarse con sigilo',level:'C1',phonetics:{infinitive:'/kri\u02d0p/',pastSimple:'/kr\u025bpt/',pastParticiple:'/kr\u025bpt/'},exampleEn:'The cat crept quietly toward the bird.',exampleEs:'El gato se desliz\xf3 sigilosamente hacia el p\xe1jaro.'},{id:'iv-flee',infinitive:'flee',pastSimple:'fled',pastParticiple:'fled',translation:'Huir / Escapar',level:'C1',phonetics:{infinitive:'/fli\u02d0/',pastSimple:'/fl\u025bd/',pastParticiple:'/fl\u025bd/'},exampleEn:'The villagers fled before the hurricane struck.',exampleEs:'Los habitantes huyeron antes de que azotara el hurac\xe1n.'},{id:'iv-fling',infinitive:'fling',pastSimple:'flung',pastParticiple:'flung',translation:'Arrojar con fuerza / Lanzar',level:'C1',phonetics:{infinitive:'/fl\u026a\u014b/',pastSimple:'/fl\u028c\u014b/',pastParticiple:'/fl\u028c\u014b/'},exampleEn:'He flung his coat onto the chair and sat down.',exampleEs:'Arroj\xf3 su abrigo sobre la silla y se sent\xf3.'},{id:'iv-grind',infinitive:'grind',pastSimple:'ground',pastParticiple:'ground',translation:'Moler / Triturar',level:'C1',phonetics:{infinitive:'/\u0261ra\u026and/',pastSimple:'/\u0261ra\u028and/',pastParticiple:'/\u0261ra\u028and/'},exampleEn:'They ground fresh coffee beans every morning.',exampleEs:'Mol\xedan granos de caf\xe9 frescos cada ma\xf1ana.'},{id:'iv-kneel',infinitive:'kneel',pastSimple:'knelt',pastParticiple:'knelt',translation:'Arrodillarse',level:'C1',phonetics:{infinitive:'/ni\u02d0l/',pastSimple:'/n\u025blt/',pastParticiple:'/n\u025blt/'},exampleEn:'She knelt on the grass to inspect the plant.',exampleEs:'Ella se arrodill\xf3 en el c\xe9sped para inspeccionar la planta.'},{id:'iv-leap',infinitive:'leap',pastSimple:'leapt',pastParticiple:'leapt',translation:'Saltar / Brincar',level:'C1',phonetics:{infinitive:'/li\u02d0p/',pastSimple:'/l\u025bpt/',pastParticiple:'/l\u025bpt/'},exampleEn:'The dolphin leapt gracefully out of the water.',exampleEs:'El delf\xedn salt\xf3 con gracia fuera del agua.'},{id:'iv-shed',infinitive:'shed',pastSimple:'shed',pastParticiple:'shed',translation:'Desprenderse de / Derramar (l\xe1grimas/luz)',level:'C1',phonetics:{infinitive:'/\u0283\u025bd/',pastSimple:'/\u0283\u025bd/',pastParticiple:'/\u0283\u025bd/'},exampleEn:'The new data shed light on the investigation.',exampleEs:'Los nuevos datos arrojaron luz sobre la investigaci\xf3n.'},{id:'iv-shrink',infinitive:'shrink',pastSimple:'shrank',pastParticiple:'shrunk',translation:'Encoger / Disminuir',level:'C1',phonetics:{infinitive:'/\u0283r\u026a\u014bk/',pastSimple:'/\u0283r\xe6\u014bk/',pastParticiple:'/\u0283r\u028c\u014bk/'},exampleEn:'The wool sweater shrank in hot water.',exampleEs:'El su\xe9ter de lana encogi\xf3 con agua caliente.'},{id:'iv-stride',infinitive:'stride',pastSimple:'strode',pastParticiple:'stridden',translation:'Caminar a zancadas',level:'C2',phonetics:{infinitive:'/stra\u026ad/',pastSimple:'/stro\u028ad/',pastParticiple:'/\u02c8str\u026ad\u0259n/'},exampleEn:'The director strode purposefully into the boardroom.',exampleEs:'El director entr\xf3 a zancadas y con determinaci\xf3n a la sala de juntas.'},{id:'iv-strive',infinitive:'strive',pastSimple:'strove',pastParticiple:'striven',translation:'Esforzarse / Luchar por',level:'C2',phonetics:{infinitive:'/stra\u026av/',pastSimple:'/stro\u028av/',pastParticiple:'/\u02c8str\u026av\u0259n/'},exampleEn:'The researchers strove to achieve absolute accuracy.',exampleEs:'Los investigadores se esforzaron por lograr una precisi\xf3n absoluta.'},{id:'iv-tread',infinitive:'tread',pastSimple:'trod',pastParticiple:'trodden',translation:'Pisar / Huella',level:'C2',phonetics:{infinitive:'/tr\u025bd/',pastSimple:'/tr\u0252d/',pastParticiple:'/\u02c8tr\u0252d\u0259n/'},exampleEn:'We trod carefully along the icy path.',exampleEs:'Pisamos con cuidado por el sendero helado.'},{id:'iv-weave',infinitive:'weave',pastSimple:'wove',pastParticiple:'woven',translation:'Tejer / Entrelazar',level:'C2',phonetics:{infinitive:'/wi\u02d0v/',pastSimple:'/wo\u028av/',pastParticiple:'/\u02c8wo\u028av\u0259n/'},exampleEn:'She wove a compelling narrative throughout the book.',exampleEs:'Ella teji\xf3 una narrativa convincente a lo largo del libro.'},{id:'iv-withstand',infinitive:'withstand',pastSimple:'withstood',pastParticiple:'withstood',translation:'Resistir / Aguantar',level:'C2',phonetics:{infinitive:'/w\u026a\xf0\u02c8st\xe6nd/',pastSimple:'/w\u026a\xf0\u02c8st\u028ad/',pastParticiple:'/w\u026a\xf0\u02c8st\u028ad/'},exampleEn:'The structure withstood severe earthquakes.',exampleEs:'La estructura resisti\xf3 intensos terremotos.'},{id:'iv-wring',infinitive:'wring',pastSimple:'wrung',pastParticiple:'wrung',translation:'Escurrir / Retorcer',level:'C2',phonetics:{infinitive:'/r\u026a\u014b/',pastSimple:'/r\u028c\u014b/',pastParticiple:'/r\u028c\u014b/'},exampleEn:'She wrung out the wet towel before hanging it.',exampleEs:'Ella escurri\xf3 la toalla mojada antes de colgarla.'}]},2366,[]);
