  // Gemini API Configuration & Storage
  var GEMINI_STORAGE_KEY = 'pronounceit_gemini_api_key';
  function getGeminiApiKey() {
    try {
      var local = _storage.appStorage.getItem(GEMINI_STORAGE_KEY);
      if (local && local.trim()) return local.trim();
    } catch {}
    return (_expoVirtualEnv.env.EXPO_PUBLIC_GEMINI_API_KEY || process.env.VITE_GEMINI_API_KEY || '').trim();
  }
  function setGeminiApiKey(key) {
    try {
      var trimmed = (key || '').trim();
      if (trimmed) {
        _storage.appStorage.setItem(GEMINI_STORAGE_KEY, trimmed);
      } else {
        _storage.appStorage.removeItem(GEMINI_STORAGE_KEY);
      }
    } catch {}
  }
  function isGeminiConfigured() {
    return Boolean(getGeminiApiKey());
  }
  var GEMINI_AVAILABLE_MODELS = ['gemini-3.5-flash', 'gemini-3.5-flash-lite', 'gemini-3.7-flash', 'gemini-3.8-flash', 'gemini-2.5-flash', 'gemini-flash-latest'];
  async function testGeminiConnection(keyToTest) {
    var apiKey = (keyToTest !== undefined ? keyToTest : getGeminiApiKey()).trim();
    if (!apiKey) {
      return {
        success: false,
        message: 'No se ha proporcionado ninguna clave API.'
      };
    }
    var models = GEMINI_AVAILABLE_MODELS;
    var lastError = '';
    for (var model of models) {
      try {
        var url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`;
        var res = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            contents: [{
              parts: [{
                text: 'Respond strictly with valid JSON: {"status": "ok"}'
              }]
            }],
            generationConfig: {
              responseMimeType: 'application/json'
            }
          })
        });
        if (res.ok) {
          return {
            success: true,
            message: `Conexión exitosa con ${model} de Google AI.`,
            model
          };
        } else {
          var errJson = await res.json().catch(() => null);
          var errMsg = errJson?.error?.message || `Error HTTP ${res.status}`;
          lastError = errMsg;
        }
      } catch (e) {
        lastError = e?.message || 'Error de red al conectar con Gemini';
      }
    }
    return {
      success: false,
      message: lastError || 'No se pudo conectar con la API de Gemini.'
    };
  }

  // Queries Google Gemini free API for rich, authentic, non-repetitive lexical analysis
  async function queryGeminiForWord(word, customApiKey) {
    var apiKey = (customApiKey !== undefined ? customApiKey : getGeminiApiKey()).trim();
    if (!apiKey) return null;
    var clean = word.trim();
    if (!clean) return null;
    var prompt = `You are an expert bilingual English-Spanish lexicographer and English teacher.
Analyze this English word or phrase: "${clean}".

CRITICAL INSTRUCTION FOR EXAMPLES:
- Generate an authentic, realistic, context-appropriate, and engaging example sentence in English demonstrating natural usage of "${clean}".
- NEVER use generic repetitive templates (e.g. avoid "She showed me the...", "I want to...", "It was a very..."). The sentence must be vivid, varied, natural, and directly suited to this specific word.
- Translate that exact sentence into natural, fluent Spanish.

Respond strictly with a single JSON object with these exact keys:
{
  "translation": "Most accurate, common and natural Spanish translation for this word",
  "partOfSpeech": "One of: 'noun', 'verb', 'adjective', 'adverb', 'article', 'pronoun', 'preposition', 'conjunction', 'phrasal verb', 'phrase'",
  "level": "CEFR level: 'A1', 'A2', 'B1', 'B2', 'C1', or 'C2'",
  "ipa": "Standard IPA phonetics with stress mark (e.g. /ˈbreɪkˌθruː/)",
  "phoneticGuide": "Friendly Spanish phonetic pronunciation approximation in quotes (e.g. \\"breik-zru\\")",
  "phoneticNote": "Short pronunciation tip for Spanish speakers regarding pronunciation or stress",
  "definition": "Clear, concise Spanish definition of the word",
  "exampleEn": "Natural, rich, non-repetitive English example sentence using the word naturally in context",
  "exampleEs": "Natural, fluent Spanish translation of the example sentence"
}`;
    var models = GEMINI_AVAILABLE_MODELS;
    for (var model of models) {
      try {
        var url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`;
        var response = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            contents: [{
              parts: [{
                text: prompt
              }]
            }],
            generationConfig: {
              responseMimeType: 'application/json',
              temperature: 0.5
            }
          })
        });
        if (!response.ok) {
          console.warn(`[Gemini API] Model ${model} returned HTTP ${response.status}`);
          continue;
        }
        var data = await response.json();
        var rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!rawText) continue;
        var parsed = JSON.parse(rawText);
        var capWord = clean.charAt(0).toUpperCase() + clean.slice(1);
        var pos = normalizePartOfSpeech(parsed.partOfSpeech || 'noun');
        var validLevels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
        var level = validLevels.includes(parsed.level) ? parsed.level : 'B1';
        return {
          word: capWord,
          partOfSpeech: pos,
          level,
          ipa: (parsed.ipa || `/${clean.toLowerCase()}/`).trim(),
          phoneticGuide: (parsed.phoneticGuide || `"${clean.toLowerCase()}"`).trim(),
          phoneticNote: (parsed.phoneticNote || 'Pronunciación estándar en inglés').trim(),
          translation: (parsed.translation || clean).trim(),
          definition: (parsed.definition || `Término utilizado como ${pos} en inglés`).trim(),
          exampleEn: (parsed.exampleEn || `${capWord} is used in English.`).trim(),
          exampleEs: (parsed.exampleEs || `Se utiliza en inglés.`).trim(),
          categoryGroup: '',
          categorySub: ''
        };
      } catch (err) {
        console.warn(`[Gemini API] Error querying ${model}:`, err);
      }
    }
    return null;
  }

  // High-accuracy Google Translate helper for single words and natural sentences
  async function translateText(text) {
    var clean = text.trim();
    if (!clean) return '';
    if (!_networkService.networkService.isOnline()) return clean;
    try {
      var url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=es&dt=t&q=${encodeURIComponent(clean)}`;
      var res = await fetchWithTimeout(url, {}, 1500);
      if (res.ok) {
        var data = await res.json();
        if (Array.isArray(data?.[0])) {
          var translated = data[0].map(item => item[0]).join('').trim();
          if (translated) return translated;
        }
      }
    } catch (e) {
      console.warn('[translateText] Google API fallback:', e);
    }

    // Secondary fallback: MyMemory API
    try {
      var _url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(clean)}&langpair=en|es`;
      var _res = await fetchWithTimeout(_url, {}, 1500);
      if (_res.ok) {
        var _data = await _res.json();
        var txt = _data?.responseData?.translatedText;
        if (txt && !txt.includes('MYMEMORY WARNING')) {
          return txt.replace(/[.!]$/, '').trim();
        }
      }
    } catch {}
    return clean;
  }

  // Retrieves accurate dictionary translation and part of speech from Google Translate Dictionary endpoint
  async function fetchGoogleDictionary(word) {
    var clean = word.trim().toLowerCase();
    if (!_networkService.networkService.isOnline()) return {
      translation: ''
    };
    try {
      var url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=es&dt=t&dt=bd&q=${encodeURIComponent(clean)}`;
      var res = await fetchWithTimeout(url, {}, 1500);
      if (res.ok) {
        var data = await res.json();
        var translation = '';
        var partOfSpeech = undefined;
        var alternatives = [];
        if (Array.isArray(data?.[0])) {
          translation = data[0].map(x => x[0]).join('').trim();
        }
        if (Array.isArray(data?.[1]) && data[1].length > 0) {
          var primary = data[1][0];
          if (primary && primary[0]) {
            partOfSpeech = normalizePartOfSpeech(primary[0]);
          }
          if (Array.isArray(primary?.[1])) {
            primary[1].slice(0, 4).forEach(t => {
              if (t && typeof t === 'string') alternatives.push(t);
            });
          }
        }
        return {
          translation,
          partOfSpeech,
          alternatives
        };
      }
    } catch (e) {
      console.warn('[fetchGoogleDictionary] Error:', e);
    }
    return {
      translation: ''
    };
  }

  // Normalized part of speech mapping with precedence order (adv, phrasal must precede verb!)
  function normalizePartOfSpeech(pos) {
    var p = (pos || '').toLowerCase().trim();
    if (!p) return 'noun';
    if (p.includes('art') || p === 'determiner') return 'article';
    if (p.includes('phrasal')) return 'phrasal verb';
    if (p.includes('adv')) return 'adverb';
    if (p.includes('adj')) return 'adjective';
    if (p.includes('verb')) return 'verb';
    if (p.includes('noun')) return 'noun';
    if (p.includes('pron')) return 'pronoun';
    if (p.includes('prep')) return 'preposition';
    if (p.includes('conj')) return 'conjunction';
    if (p.includes('interj')) return 'interjection';
    if (p.includes('phrase') || p.includes('idiom') || p.includes('expression')) return 'phrase';
    return p;
  }
  function detectQuickPartOfSpeech(word) {
    var w = word.toLowerCase().trim();
    if (['the', 'a', 'an'].includes(w)) return 'article';
    if (['in', 'on', 'at', 'by', 'for', 'with', 'about', 'against', 'between', 'into', 'through', 'during', 'before', 'after', 'above', 'below', 'to', 'from', 'up', 'down', 'off', 'over', 'under'].includes(w)) return 'preposition';
    if (['and', 'but', 'or', 'so', 'because', 'although', 'since', 'unless', 'while', 'whereas', 'if'].includes(w)) return 'conjunction';
    if (['i', 'you', 'he', 'she', 'it', 'we', 'they', 'me', 'him', 'her', 'us', 'them', 'my', 'your', 'his', 'our', 'their', 'mine', 'yours', 'hers', 'ours', 'theirs', 'this', 'that', 'these', 'those'].includes(w)) return 'pronoun';
    if (['be', 'is', 'are', 'was', 'were', 'have', 'has', 'do', 'does', 'go', 'make', 'take', 'see', 'come', 'get', 'give', 'know', 'think', 'say', 'look', 'want', 'use', 'find', 'tell', 'ask', 'work', 'seem', 'feel', 'try', 'leave', 'call', 'run', 'read', 'write', 'learn'].includes(w)) return 'verb';
    return null;
  }

  // Searches Tatoeba for authentic bilingual human-reviewed sentences
  async function fetchTatoebaSentence(word) {
    try {
      var controller = new AbortController();
      var timeout = setTimeout(() => controller.abort(), 1600);
      var res = await fetch(`https://tatoeba.org/en/api_v0/search?from=eng&to=spa&query=${encodeURIComponent(word.toLowerCase().trim())}`, {
        signal: controller.signal
      });
      clearTimeout(timeout);
      if (res.ok) {
        var data = await res.json();
        if (Array.isArray(data?.results) && data.results.length > 0) {
          var regex = new RegExp(`\\b${word}\\b`, 'i');
          var match = data.results.find(r => r.text && regex.test(r.text));
          if (match) {
            var trans = match.translations?.[0]?.[0]?.text;
            return {
              exampleEn: match.text,
              exampleEs: trans
            };
          }
        }
      }
    } catch {}
    return null;
  }

  // Generates an authentic, grammatically correct contextual sentence pair
  async function generateNaturalSentencePair(word, pos) {
    var w = word.trim().toLowerCase();
    var cap = w.charAt(0).toUpperCase() + w.slice(1);
    var p = (pos || '').toLowerCase();

    // 1. Try Tatoeba first for genuine human sentences
    var tatoeba = await fetchTatoebaSentence(w);
    if (tatoeba?.exampleEn) {
      var es = tatoeba.exampleEs || (await translateText(tatoeba.exampleEn));
      return {
        exampleEn: tatoeba.exampleEn,
        exampleEs: es
      };
    }

    // 2. Varied contextual templates by hash to avoid repetitive sentences across words
    var hash = w.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
    var enSentence = '';
    if (p.includes('art')) {
      if (w === 'the') {
        enSentence = 'The little prince looked at the bright stars in the sky.';
      } else if (w === 'a') {
        enSentence = 'I saw a beautiful flower growing in the garden.';
      } else if (w === 'an') {
        enSentence = 'She ate an apple while reading her favorite book.';
      } else {
        enSentence = `${cap} sun is shining brightly today.`;
      }
    } else if (p.includes('adv')) {
      var templates = [`She completed the task ${w} and without any mistakes.`, `They were speaking ${w} during the morning meeting.`, `The situation improved ${w} over the last few weeks.`, `He answered all the difficult questions ${w}.`];
      enSentence = templates[hash % templates.length];
    } else if (p.includes('adj')) {
      var _templates = [`It was a very ${w} experience for the whole team.`, `She gave a ${w} explanation during the presentation.`, `The project requires a ${w} approach to succeed.`, `We noticed a ${w} difference in the final results.`];
      enSentence = _templates[hash % _templates.length];
    } else if (p.includes('verb')) {
      var _templates2 = [`I need to ${w} this matter carefully before making a choice.`, `They decided to ${w} together on the new initiative.`, `You should ${w} every day to make steady progress.`, `We hope to ${w} significant milestones by next month.`];
      enSentence = _templates2[hash % _templates2.length];
    } else if (p.includes('prep')) {
      var _templates3 = [`The notebook was placed ${w} the wooden desk.`, `We walked ${w} the quiet path in the morning.`, `The keys were found ${w} the front door.`];
      enSentence = _templates3[hash % _templates3.length];
    } else if (p.includes('conj')) {
      var _templates4 = [`We stayed inside ${w} the weather was stormy.`, `He worked late ${w} the deadline was approaching.`, `She smiled ${w} she received the good news.`];
      enSentence = _templates4[hash % _templates4.length];
    } else if (p.includes('pron')) {
      enSentence = `${cap} decided to visit the local library.`;
    } else if (p.includes('phrasal') || p.includes('idiom') || w.includes(' ')) {
      var _templates5 = [`They promised to ${w} as soon as possible.`, `It is not easy to ${w} without proper preparation.`, `We will certainly ${w} during tomorrow's session.`];
      enSentence = _templates5[hash % _templates5.length];
    } else {
      // Noun templates with rich variety
      var _templates6 = [`The manager discussed the new ${w} during the conference.`, `Understanding the importance of this ${w} will help us succeed.`, `They found an interesting article about the ${w} online.`, `We need to focus our attention on this particular ${w}.`, `She shared valuable insights regarding the ${w}.`];
      enSentence = _templates6[hash % _templates6.length];
    }

    // Translate sentence accurately with Google Translate
    var esSentence = await translateText(enSentence);
    return {
      exampleEn: enSentence,
      exampleEs: esSentence
    };
  }

  // Algorithmic phonetic approximation generator
  function generatePhoneticGuide(word) {
    var guide = word.toLowerCase();
    guide = guide.replace(/tion\b/g, 'shon').replace(/sion\b/g, 'zhon').replace(/ight\b/g, 'ait').replace(/th/g, 'z').replace(/ee|ea/g, 'ii').replace(/oo/g, 'uu').replace(/ph/g, 'f').replace(/sh/g, 'sh').replace(/ch/g, 'ch').replace(/qu/g, 'ku').replace(/ck/g, 'k').replace(/w/g, 'u').replace(/y\b/g, 'i');
    return `"${guide}"`;
  }
