    var controller = new AbortController();
    var timer = setTimeout(() => controller.abort(), timeoutMs);
    try {
      var res = await fetch(url, {
        ...options,
        signal: controller.signal
      });
      clearTimeout(timer);
      return res;
    } catch (e) {
      clearTimeout(timer);
      throw e;
    }
