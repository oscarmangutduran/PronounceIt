# ==============================================================================
# PRONOUNCEIT - CLIENT ENVIRONMENT CONFIGURATION (PUBLIC BUNDLE ONLY)
# ==============================================================================
# SEGURIDAD:
# Todas las variables con prefijo VITE_ o EXPO_PUBLIC_ se compilan en el bundle
# final de la aplicación móvil y web. Son visibles públicamente para cualquiera
# que inspeccione el código o descompile el APK.
#
# NUNCA agregues claves privadas aquí (como GEMINI_API_KEY, Stripe Secret Keys,
# o credenciales de Service Account). Las APIs de terceros deben invocarse
# exclusivamente a través de Firebase Cloud Functions seguras.
# ==============================================================================

# Backend API URL (Express / Cloud Functions proxy)
EXPO_PUBLIC_API_URL="http://localhost:5000/api"
VITE_API_URL="http://localhost:5000/api"

# Firebase Client SDK Configuration (Identificadores públicos de proyecto)
# Estos valores identifican tu proyecto en Firebase y están protegidos mediante
# Firestore Security Rules y Firebase App Check.
VITE_FIREBASE_API_KEY="AIzaSyYourClientApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Expo Public Variables (Para empaquetado React Native / Expo)
EXPO_PUBLIC_FIREBASE_API_KEY="AIzaSyYourClientApiKeyHere"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
EXPO_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
